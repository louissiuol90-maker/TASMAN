<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand / section colours (light theme). Night variants live in values-night/colors.xml. -->
    <color name="colorPrimary">#1565C0</color>
    <color name="colorPrimaryVariant">#0D47A1</color>
    <color name="colorAccent">#00695C</color>

    <!-- Colour-coded sections -->
    <color name="section_processes">#1565C0</color>
    <color name="section_privacy">#C62828</color>
    <color name="section_tower">#00695C</color>

    <!-- Foreground vs background chips -->
    <color name="chip_foreground">#2E7D32</color>
    <color name="chip_background">#EF6C00</color>
    <color name="chip_text">#FFFFFF</color>

    <!-- Privacy Guard: alert = red, allowed = green, warning = amber -->
    <color name="alert_red">#B00020</color>
    <color name="alert_bg">#FFCDD2</color>
    <color name="allowed_green">#2E7D32</color>
    <color name="allowed_bg">#C8E6C9</color>
    <color name="warn_amber">#F57F17</color>
    <color name="warn_bg">#FFF3E0</color>

    <!-- Filter buttons: selected stands out, unselected is quiet -->
    <color name="filter_selected_bg">#1565C0</color>
    <color name="filter_selected_text">#FFFFFF</color>
    <color name="filter_unselected_bg">#E3EAF2</color>
    <color name="filter_unselected_text">#37474F</color>

    <!-- Muted secondary text -->
    <color name="muted_text">#616161</color>
</resources>
