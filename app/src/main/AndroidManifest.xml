<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions — see README.md "Permissions" for what each one does
      and what it does NOT do. This app reads no messages, no call logs,
      no photos and no audio itself. It only asks the OS, via AppOps /
      UsageStats, whether *another* app has recently used a sensitive op.
    -->

    <!-- Needed to list installed packages and tell system apps apart. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Special access, granted by the user in Settings, not at install.
         Required for UsageStatsManager: foreground / background / last-used. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- For the Privacy Guard foreground service that polls AppOps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- AppOps history. This is a signature|privileged permission:
         declaring it does not grant it to an ordinary sideloaded app.
         See PrivacyGuard.kt and README.md. -->
    <uses-permission android:name="android.permission.GET_APP_OPS_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Cell tower logging (CellTowerLogger.kt, view-only).
         READ_PHONE_STATE: network type / operator name.
         Location (fine or coarse): Android 10+ hides cell identity
         (cell ID / TAC / LAC) without location permission, so without
         it the tower log records "needs location permission" instead
         of inventing a cell ID. Both are requested at runtime in
         MainActivity. No location is stored, uploaded, or shared —
         only the tower identity / signal, in the app's private log. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Alert notifications (Android 13+). Sound is explicitly disabled
         in the notification channel — no audio on open, no chime, no beep. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Haptic feedback for an alert only. No audio. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SystemChecker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PrivacyGuardService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
